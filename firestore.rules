rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/teman/$(b));
    }

    // Profil: semua pengguna yang login boleh membaca (untuk mencari teman),
    // tetapi hanya pemiliknya yang boleh membuat/mengubah.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Daftar teman. Ditulis untuk kedua pihak saat permintaan diterima.
      match /teman/{otherUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        // Saya menerima permintaan dari otherUid.
        allow create: if signedIn() && request.auth.uid == uid &&
          exists(/databases/$(database)/documents/friendRequests/$(otherUid + '_' + uid));
        // Saya (otherUid) menerima permintaan dari uid.
        allow create: if signedIn() && request.auth.uid == otherUid &&
          exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + otherUid));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == otherUid);
      }
    }

    // Permintaan pertemanan: id dokumen = {dari}_{ke}.
    match /friendRequests/{reqId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.from != request.resource.data.to &&
        reqId == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Kunci publik enkripsi chat. Kunci privat tidak pernah dikirim ke server.
    match /publicKeys/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Chat pribadi memakai id p_{uidA}_{uidB} dan anggotanya tidak bisa diubah.
    function isPrivateId(chatId) {
      return chatId.matches('p_.*');
    }

    function validPrivateMembers(chatId, members) {
      return members.size() == 2 &&
        (chatId == 'p_' + members[0] + '_' + members[1] ||
         chatId == 'p_' + members[1] + '_' + members[0]);
    }

    function otherOf(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // Chat pribadi baru: "aktif" hanya jika sudah berteman; jika belum,
    // menjadi "permintaan" dari saya dan saya belum memakai jatah 1 pesan.
    function validNewPrivate(data) {
      return (data.get('status', 'aktif') == 'aktif' &&
              isFriend(request.auth.uid, otherOf(data.members))) ||
             (data.get('status', '') == 'permintaan' &&
              data.get('requester', '') == request.auth.uid &&
              data.get('requestSent', false) == false);
    }

    // Perubahan chat pribadi: anggota dan pengirim permintaan tetap; status
    // hanya diubah oleh penerima permintaan, atau jika keduanya sudah berteman;
    // jatah 1 pesan tidak bisa dikembalikan.
    function validPrivateUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.members == before.members &&
        after.get('requester', '') == before.get('requester', '') &&
        (after.get('status', 'aktif') == before.get('status', 'aktif') ||
         request.auth.uid != before.get('requester', '') ||
         isFriend(request.auth.uid, otherOf(before.members))) &&
        !(before.get('requestSent', false) == true && after.get('requestSent', false) != true);
    }

    // Boleh mengirim pesan/file: chat aktif, atau saya pengirim permintaan
    // yang belum memakai jatah 1 pesan.
    function canSend(chat) {
      return chat.get('status', 'aktif') == 'aktif' ||
        (chat.get('status', '') == 'permintaan' &&
         chat.get('requester', '') == request.auth.uid &&
         chat.get('requestSent', false) == false);
    }

    // Ruang chat. Isi pesan sudah terenkripsi di HP sebelum sampai sini.
    match /chats/{chatId} {
      allow get: if signedIn() &&
        (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members &&
        (!isPrivateId(chatId) ||
         (validPrivateMembers(chatId, request.resource.data.members) &&
          validNewPrivate(request.resource.data)));
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        (!isPrivateId(chatId) || validPrivateUpdate());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        // Pesan permintaan harus dikirim bersama penanda requestSent = true
        // (dalam satu batch), sehingga hanya bisa sekali.
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          canSend(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('status', 'aktif') == 'aktif' ||
           getAfter(/databases/$(database)/documents/chats/$(chatId)).data.get('requestSent', false) == true);
        allow update, delete: if false;
      }

      // Potongan foto/file terenkripsi (maks. ~700 KB per potongan).
      match /files/{partId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) &&
          request.resource.data.by == request.auth.uid &&
          request.resource.data.data.size() < 800000 &&
          canSend(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow update, delete: if false;
      }
    }

    // Tugas: hanya pemiliknya yang boleh membaca dan mengubah.
    match /users/{uid}/tugas/{tugasId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kapan saya terakhir membaca tiap chat (untuk hitungan pesan belum dibaca).
    // Pribadi: hanya pemiliknya.
    match /users/{uid}/bacaan/{chatId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Tanda "ada pesan baru" untuk pemeriksaan notifikasi di latar belakang.
    match /inbox/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.keys().hasOnly(['at', 'from', 'chat']);
    }

    // Foto profil yang diunggah sendiri (diperkecil, maks. ~400 KB).
    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid &&
        (request.resource == null || request.resource.data.data.size() < 450000);
    }

    // Foto grup: anggota grup boleh mengganti.
    match /groupAvatars/{chatId} {
      allow read: if signedIn();
      allow write: if isChatMember(chatId) && request.resource.data.data.size() < 450000;
    }

    // Story catatan: hanya pemilik dan temannya yang bisa membaca.
    match /stories/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid, request.auth.uid));
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
