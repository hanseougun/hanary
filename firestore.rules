rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/teman/$(b));
    }

    // Profil: semua pengguna yang login boleh membaca (untuk mencari teman),
    // tetapi hanya pemiliknya yang boleh membuat/mengubah.
    // Username di profil harus sama dengan yang sudah saya pesan di
    // usernames/{username} (atau tidak berubah / kosong).
    function usernameSah(uid) {
      let u = request.resource.data.get('username', '');
      return u == '' ||
        (resource != null && u == resource.data.get('username', '')) ||
        getAfter(/databases/$(database)/documents/usernames/$(u)).data.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && usernameSah(uid);
      allow delete: if false;

      // Daftar teman. Ditulis untuk kedua pihak saat permintaan diterima.
      match /teman/{otherUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        // Saya menerima permintaan dari otherUid.
        allow create: if signedIn() && request.auth.uid == uid &&
          exists(/databases/$(database)/documents/friendRequests/$(otherUid + '_' + uid));
        // Saya (otherUid) menerima permintaan dari uid.
        allow create: if signedIn() && request.auth.uid == otherUid &&
          exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + otherUid));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == otherUid);
      }
    }

    // Username unik: siapa yang memesan pertama, dia pemiliknya.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        name.matches('^[a-z0-9._]{3,20}$') &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Permintaan pertemanan: id dokumen = {dari}_{ke}.
    match /friendRequests/{reqId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.from != request.resource.data.to &&
        reqId == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Kunci publik enkripsi chat. Kunci privat tidak pernah dikirim ke server.
    match /publicKeys/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Chat pribadi memakai id p_{uidA}_{uidB} dan anggotanya tidak bisa diubah.
    function isPrivateId(chatId) {
      return chatId.matches('p_.*');
    }

    function validPrivateMembers(chatId, members) {
      return members.size() == 2 &&
        (chatId == 'p_' + members[0] + '_' + members[1] ||
         chatId == 'p_' + members[1] + '_' + members[0]);
    }

    function otherOf(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // Chat pribadi baru: "aktif" hanya jika sudah berteman; jika belum,
    // menjadi "permintaan" dari saya dan saya belum memakai jatah 1 pesan.
    function validNewPrivate(data) {
      return (data.get('status', 'aktif') == 'aktif' &&
              isFriend(request.auth.uid, otherOf(data.members))) ||
             (data.get('status', '') == 'permintaan' &&
              data.get('requester', '') == request.auth.uid &&
              data.get('requestSent', false) == false);
    }

    // Perubahan chat pribadi: anggota dan pengirim permintaan tetap; status
    // hanya diubah oleh penerima permintaan, atau jika keduanya sudah berteman;
    // jatah 1 pesan tidak bisa dikembalikan.
    function validPrivateUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.members == before.members &&
        after.get('requester', '') == before.get('requester', '') &&
        (after.get('status', 'aktif') == before.get('status', 'aktif') ||
         request.auth.uid != before.get('requester', '') ||
         isFriend(request.auth.uid, otherOf(before.members))) &&
        !(before.get('requestSent', false) == true && after.get('requestSent', false) != true);
    }

    // Pemilik grup: field admin, atau anggota pertama jika pemiliknya sudah keluar.
    function pemilikGrup(data) {
      return data.get('admin', '') in data.members ? data.get('admin', '') : data.members[0];
    }

    // Perubahan grup: hanya pemilik yang boleh mengeluarkan orang lain dan
    // memindahkan kepemilikan (ke anggota grup). Anggota biasa hanya boleh
    // mengeluarkan dirinya sendiri.
    function validGroupUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let pemilik = pemilikGrup(before) == request.auth.uid;
      let keluar = before.members.toSet().difference(after.members.toSet());
      return (keluar.hasOnly([request.auth.uid]) || pemilik) &&
        (after.get('admin', '') == before.get('admin', '') ||
         (pemilik && after.get('admin', '') in after.members));
    }

    // Boleh mengirim pesan/file: chat aktif, atau saya pengirim permintaan
    // yang belum memakai jatah 1 pesan.
    function canSend(chat) {
      return chat.get('status', 'aktif') == 'aktif' ||
        (chat.get('status', '') == 'permintaan' &&
         chat.get('requester', '') == request.auth.uid &&
         chat.get('requestSent', false) == false);
    }

    // Ruang chat. Isi pesan sudah terenkripsi di HP sebelum sampai sini.
    match /chats/{chatId} {
      allow get: if signedIn() &&
        (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members &&
        (!isPrivateId(chatId) ||
         (validPrivateMembers(chatId, request.resource.data.members) &&
          validNewPrivate(request.resource.data)));
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        (!isPrivateId(chatId) || validPrivateUpdate()) &&
        (isPrivateId(chatId) || validGroupUpdate());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        // Pesan permintaan harus dikirim bersama penanda requestSent = true
        // (dalam satu batch), sehingga hanya bisa sekali.
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          canSend(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('status', 'aktif') == 'aktif' ||
           getAfter(/databases/$(database)/documents/chats/$(chatId)).data.get('requestSent', false) == true);
        // Tarik pesan: hanya pengirimnya, dan isinya (termasuk kutipan
        // pesan yang dibalas) harus dikosongkan.
        allow update: if isChatMember(chatId) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['box', 'ditarik', 'balas']) &&
          request.resource.data.box == '' &&
          request.resource.data.ditarik == true &&
          !('balas' in request.resource.data);
        allow delete: if false;
      }

      // Potongan foto/file terenkripsi (maks. ~700 KB per potongan).
      match /files/{partId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) &&
          request.resource.data.by == request.auth.uid &&
          request.resource.data.data.size() < 800000 &&
          canSend(get(/databases/$(database)/documents/chats/$(chatId)).data);
        // Pengirim boleh menghapus potongan filenya sendiri (saat pesan ditarik).
        allow delete: if isChatMember(chatId) && resource.data.by == request.auth.uid;
        allow update: if false;
      }
    }

    // Tugas: hanya pemiliknya yang boleh membaca dan mengubah.
    match /users/{uid}/tugas/{tugasId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pengaturan pribadi tiap chat: disematkan, diarsipkan, dihapus untuk
    // saya, dan pesan berbintang. Hanya pemiliknya.
    match /users/{uid}/obrolan/{chatId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['disematkan', 'arsip', 'hapusSebelum', 'bintang']) &&
        request.resource.data.get('bintang', []).size() <= 500;
    }

    // Panggilan yang saya hapus dari riwayat. Hanya pemiliknya.
    match /users/{uid}/riwayatPanggilan/{callId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Kapan saya terakhir membaca tiap chat (untuk hitungan pesan belum dibaca).
    // Pribadi: hanya pemiliknya.
    match /users/{uid}/bacaan/{chatId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Tanda "ada pesan baru" untuk pemeriksaan notifikasi di latar belakang.
    match /inbox/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.keys().hasOnly(['at', 'from', 'chat']);
    }

    // Alamat FCM HP pengguna (untuk notifikasi instan). Hanya pemiliknya;
    // server notifikasi membacanya dengan akun layanan.
    match /fcmTokens/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['token', 'diperbarui']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() < 4096;
    }

    // Panggilan suara/video. Suara dan gambar dikirim langsung antar HP;
    // di sini hanya status panggilan dan sinyal untuk menyambungkan.
    function panggilanData(callId) {
      return get(/databases/$(database)/documents/panggilan/$(callId)).data;
    }

    // Daftar [after] sama dengan [before], hanya boleh ditambah/dikurangi saya.
    function hanyaSaya(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid]) &&
        before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    // Orang baru yang diajak ke panggilan: tepat satu teman saya, ditambahkan
    // di akhir daftar, oleh orang yang sedang ikut. Maks. 8 orang.
    function tambahSatuTeman(before, after) {
      return after.anggota.size() == before.anggota.size() + 1 &&
        after.anggota.size() <= 8 &&
        after.anggota[0:before.anggota.size()] == before.anggota &&
        request.auth.uid in before.ikut &&
        before.status != 'selesai' &&
        isFriend(request.auth.uid, after.anggota[before.anggota.size()]);
    }

    match /panggilan/{callId} {
      allow get: if signedIn() &&
        (resource == null || request.auth.uid in resource.data.anggota);
      // Riwayat panggilan saya.
      allow list: if signedIn() && request.auth.uid in resource.data.anggota;
      // Memulai panggilan di chat aktif; yang dipanggil = semua anggota chat.
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(
          ['chatId', 'dari', 'video', 'grup', 'anggota', 'ikut', 'pernah', 'tolak', 'status', 'dibuatMs', 'dibuat']) &&
        request.resource.data.dari == request.auth.uid &&
        request.resource.data.ikut == [request.auth.uid] &&
        request.resource.data.get('pernah', [request.auth.uid]) == [request.auth.uid] &&
        request.resource.data.tolak == [] &&
        request.resource.data.status == 'berdering' &&
        request.resource.data.video is bool &&
        isChatMember(request.resource.data.chatId) &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members ==
          request.resource.data.anggota &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.get('status', 'aktif') == 'aktif';
      // Ikut/keluar/menolak hanya untuk diri sendiri; panggilan yang
      // selesai tidak bisa dimulai lagi; mengajak teman satu per satu.
      allow update: if signedIn() && request.auth.uid in resource.data.anggota &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ikut', 'tolak', 'status', 'pernah', 'anggota', 'mulaiMs', 'selesaiMs']) &&
        hanyaSaya(resource.data.ikut, request.resource.data.ikut) &&
        hanyaSaya(resource.data.tolak, request.resource.data.tolak) &&
        hanyaSaya(resource.data.get('pernah', []), request.resource.data.get('pernah', [])) &&
        (request.resource.data.anggota == resource.data.anggota ||
         tambahSatuTeman(resource.data, request.resource.data)) &&
        request.resource.data.get('mulaiMs', 0) is number &&
        request.resource.data.get('selesaiMs', 0) is number &&
        request.resource.data.status in ['berdering', 'berlangsung', 'selesai'] &&
        (resource.data.status != 'selesai' || request.resource.data.status == 'selesai');
      allow delete: if false;

      // Sinyal WebRTC (penawaran, jawaban, kandidat jaringan) antar dua peserta.
      match /sinyal/{sinyalId} {
        allow read: if signedIn() &&
          (resource.data.ke == request.auth.uid || resource.data.dari == request.auth.uid) &&
          request.auth.uid in panggilanData(callId).anggota;
        allow create: if signedIn() &&
          request.resource.data.dari == request.auth.uid &&
          request.auth.uid in panggilanData(callId).ikut &&
          request.resource.data.ke in panggilanData(callId).anggota &&
          request.resource.data.jenis in ['offer', 'answer', 'ice'];
        allow update, delete: if false;
      }
    }

    // Tanda "ada yang menelepon" untuk tiap orang (dipantau saat aplikasi terbuka).
    match /panggilanMasuk/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Oleh pemanggil, atau oleh orang yang sedang ikut panggilan (mengajak).
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly(['callId', 'dari', 'at']) &&
        request.resource.data.dari == request.auth.uid &&
        (getAfter(/databases/$(database)/documents/panggilan/$(request.resource.data.callId)).data.dari == request.auth.uid ||
         request.auth.uid in getAfter(/databases/$(database)/documents/panggilan/$(request.resource.data.callId)).data.ikut) &&
        uid in getAfter(/databases/$(database)/documents/panggilan/$(request.resource.data.callId)).data.anggota;
    }

    // Foto profil yang diunggah sendiri (diperkecil, maks. ~400 KB).
    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid &&
        (request.resource == null || request.resource.data.data.size() < 450000);
    }

    // Foto grup: anggota grup boleh mengganti.
    match /groupAvatars/{chatId} {
      allow read: if signedIn();
      allow write: if isChatMember(chatId) && request.resource.data.data.size() < 450000;
    }

    // Story catatan: hanya pemilik dan temannya yang bisa membaca.
    match /stories/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid, request.auth.uid));
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
